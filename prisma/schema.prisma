generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── TENANT ───────────────────────────────────────────────────────────────────
model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  plan      String   @default("free")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users              User[]
  brands             Brand[]
  skus               Sku[]
  salesRecords       SalesRecord[]
  inventorySnapshots InventorySnapshot[]
  promoEvents        PromoEvent[]
  onboarding         OnboardingBrief?
  driveSyncs         GoogleDriveSync[]
  catalogUploads     CatalogUpload[]
  catalogItems       CatalogItem[]
  plannerCart        PlannerCart?
  marketingEvents    MarketingEvent[]
  agentRuns          AgentRun[]
  dataSources        DataSource[]
  dataImportRuns     DataImportRun[]
  dataSheetSnapshots DataSheetSnapshot[]
  dataSheetRows      DataSheetRow[]
  sourceProducts     SourceProduct[]
  sourceSaleLines    SourceSaleLine[]
  importIssues       ImportIssue[]
  reportRuns         ReportCalculationRun[]
  articleResults     ArticleReportResult[]
  brandResults       BrandReportResult[]
  categoryResults    CategoryReportResult[]
  tablePreferences   DataTablePreference[]
}

// ─── USER ─────────────────────────────────────────────────────────────────────
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(VIEWER)
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  refreshToken String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tablePreferences DataTablePreference[]

  @@unique([id, tenantId])
  @@index([tenantId])
}

enum Role {
  SUPER_ADMIN
  ADMIN
  ANALYST
  VIEWER
}

// ─── ONBOARDING ───────────────────────────────────────────────────────────────
model OnboardingBrief {
  id            String        @id @default(cuid())
  tenantId      String        @unique
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  businessModel BusinessModel
  answers       Json
  completedAt   DateTime      @default(now())
}

enum BusinessModel {
  SEASONAL
  CARRYOVER
  HYBRID
}

// ─── BRAND / SUPPLIER ─────────────────────────────────────────────────────────
model Brand {
  id           String  @id @default(cuid())
  tenantId     String
  tenant       Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  leadTimeDays Int     @default(14)
  moq          Int     @default(1)
  currency     String  @default("EUR")
  country      String?
  contact      String?
  // Planner-specific
  budget       Float   @default(0)
  paymentDays  Int     @default(30)

  skus           Sku[]
  catalogUploads CatalogUpload[]
  catalogItems   CatalogItem[]

  @@index([tenantId])
}

// ─── INVENTORY SKU ────────────────────────────────────────────────────────────
model Sku {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  brandId       String?
  brand         Brand?    @relation(fields: [brandId], references: [id])
  sku           String
  name          String
  category      String
  subcategory   String?
  priceRetail   Float
  pricePurchase Float
  season        String?
  status        SkuStatus @default(ACTIVE)
  dateAdded     DateTime  @default(now())
  dateEol       DateTime?
  tags          String[]  @default([])

  salesRecords       SalesRecord[]
  inventorySnapshots InventorySnapshot[]

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([tenantId, category])
}

enum SkuStatus {
  ACTIVE
  ARCHIVE
  NEW
  EOL
}

// ─── SALES ────────────────────────────────────────────────────────────────────
model SalesRecord {
  id       String   @id @default(cuid())
  tenantId String
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  skuId    String
  sku      Sku      @relation(fields: [skuId], references: [id], onDelete: Cascade)
  date     DateTime @db.Date
  qtySold  Int
  revenue  Float
  channel  String   @default("offline")
  isPromo  Boolean  @default(false)
  returns  Int      @default(0)

  @@index([tenantId, date])
  @@index([skuId])
  @@unique([tenantId, skuId, date, channel])
}

// ─── INVENTORY ────────────────────────────────────────────────────────────────
model InventorySnapshot {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  skuId        String
  sku          Sku      @relation(fields: [skuId], references: [id], onDelete: Cascade)
  qtyOnHand    Int
  qtyReserved  Int      @default(0)
  qtyInTransit Int      @default(0)
  snapshotDate DateTime @db.Date

  @@index([tenantId, snapshotDate])
  @@index([skuId])
  @@unique([tenantId, skuId, snapshotDate])
}

// ─── PROMO ────────────────────────────────────────────────────────────────────
model PromoEvent {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  dateStart   DateTime @db.Date
  dateEnd     DateTime @db.Date
  discountPct Float
  mechanic    String
  channel     String   @default("both")
  skuIds      String[] @default([])

  @@index([tenantId])
}

// ─── GOOGLE DRIVE ─────────────────────────────────────────────────────────────
model GoogleDriveSync {
  id           String    @id @default(cuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  driveFileId  String
  fileType     String    @default("xlsx")
  lastSyncAt   DateTime?
  syncStatus   String    @default("pending")
  errorMessage String?
  createdAt    DateTime  @default(now())

  @@index([tenantId])
}

// ══════════════════════════════════════════════════════════════════════════════
// SOURCE DATA IMPORTS AND CALCULATED REPORTS
// ══════════════════════════════════════════════════════════════════════════════

enum DataImportTrigger {
  MANUAL
  CRON
}

enum DataRunStatus {
  PENDING
  RUNNING
  SUCCESS
  WARNING
  FAILED
}

enum DataIssueSeverity {
  INFO
  WARNING
  ERROR
}

enum ProductMatchStatus {
  PENDING
  MATCHED
  AMBIGUOUS
  UNMATCHED
}

model DataSource {
  id                String         @id @default(cuid())
  tenantId          String
  tenant            Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name              String         @default("ZAVOD Google Sheets")
  driveFileId       String
  timezone          String         @default("Europe/Kyiv")
  allowedSheets     Json           @default("[]")
  activeImportRunId String?        @unique
  activeImportRun   DataImportRun? @relation("ActiveDataSourceImport", fields: [activeImportRunId], references: [id], onDelete: SetNull)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  importRuns DataImportRun[] @relation("DataSourceImports")

  @@unique([id, tenantId])
  @@unique([tenantId, driveFileId])
  @@index([tenantId])
}

model DataImportRun {
  id               String            @id @default(cuid())
  tenantId         String
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sourceId         String
  source           DataSource        @relation("DataSourceImports", fields: [sourceId, tenantId], references: [id, tenantId], onDelete: Cascade)
  trigger          DataImportTrigger
  status           DataRunStatus     @default(PENDING)
  idempotencyKey   String
  businessDate     DateTime          @db.Date
  sourceChecksum   String?
  sourceModifiedAt DateTime?
  stats            Json              @default("{}")
  errorMessage     String?
  startedAt        DateTime          @default(now())
  completedAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  activeForSource DataSource?            @relation("ActiveDataSourceImport")
  sheets          DataSheetSnapshot[]
  products        SourceProduct[]
  saleLines       SourceSaleLine[]
  issues          ImportIssue[]
  calculations    ReportCalculationRun[]

  @@unique([id, tenantId])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status, startedAt])
  @@index([sourceId, createdAt])
}

model DataSheetSnapshot {
  id          String        @id @default(cuid())
  tenantId    String
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  importRunId String
  importRun   DataImportRun @relation(fields: [importRunId, tenantId], references: [id, tenantId], onDelete: Cascade)
  sheetKey    String
  sourceName  String
  headerRow   Int
  columns     Json          @default("[]")
  rowCount    Int           @default(0)
  checksum    String?
  createdAt   DateTime      @default(now())

  rows DataSheetRow[]

  @@unique([id, tenantId])
  @@unique([importRunId, sheetKey])
  @@index([tenantId, sheetKey])
}

model DataSheetRow {
  id         String            @id @default(cuid())
  tenantId   String
  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  snapshotId String
  snapshot   DataSheetSnapshot @relation(fields: [snapshotId, tenantId], references: [id, tenantId], onDelete: Cascade)
  rowNumber  Int
  data       Json
  rowHash    String
  searchText String?
  createdAt  DateTime          @default(now())

  @@unique([snapshotId, rowNumber])
  @@index([tenantId, snapshotId])
  @@index([snapshotId, rowHash])
}

model SourceProduct {
  id              String        @id @default(cuid())
  tenantId        String
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  importRunId     String
  importRun       DataImportRun @relation(fields: [importRunId, tenantId], references: [id, tenantId], onDelete: Cascade)
  sourceRowNumber Int
  productId       String
  article         String?
  vendorCode      String?
  name            String
  brand           String?
  category        String?
  retailPrice     Decimal       @db.Decimal(18, 4)
  oldPrice        Decimal?      @db.Decimal(18, 4)
  costPrice       Decimal       @db.Decimal(18, 4)
  stockUnits      Decimal       @db.Decimal(18, 4)
  sourceStatus    String?
  sourceValues    Json          @default("{}")
  createdAt       DateTime      @default(now())

  @@unique([importRunId, productId])
  @@unique([importRunId, sourceRowNumber])
  @@index([tenantId, productId])
  @@index([importRunId, article])
  @@index([importRunId, vendorCode])
  @@index([importRunId, brand])
  @@index([importRunId, category])
}

model SourceSaleLine {
  id                 String             @id @default(cuid())
  tenantId           String
  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  importRunId        String
  importRun          DataImportRun      @relation(fields: [importRunId, tenantId], references: [id, tenantId], onDelete: Cascade)
  sourceRowNumber    Int
  sourceLineId       String?
  orderId            String?
  rowHash            String
  orderTime          DateTime?
  paymentDate        DateTime?          @db.Date
  statusId           Int?
  productSku         String?
  productParameter   String?
  sourceProductId    String?
  manufacturer       String?
  quantity           Decimal            @db.Decimal(18, 4)
  salesAmount        Decimal            @db.Decimal(18, 4)
  costAmount         Decimal            @db.Decimal(18, 4)
  normalizedQuantity Decimal?           @db.Decimal(18, 4)
  normalizedSales    Decimal?           @db.Decimal(18, 4)
  normalizedCost     Decimal?           @db.Decimal(18, 4)
  matchStatus        ProductMatchStatus @default(PENDING)
  matchMethod        String?
  resolvedProductId  String?
  sourceValues       Json               @default("{}")
  createdAt          DateTime           @default(now())

  @@unique([importRunId, sourceRowNumber])
  @@index([tenantId, paymentDate])
  @@index([importRunId, statusId, paymentDate])
  @@index([importRunId, productSku])
  @@index([importRunId, productParameter])
  @@index([importRunId, resolvedProductId])
  @@index([importRunId, matchStatus])
}

model ImportIssue {
  id          String            @id @default(cuid())
  tenantId    String
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  importRunId String
  importRun   DataImportRun     @relation(fields: [importRunId, tenantId], references: [id, tenantId], onDelete: Cascade)
  sheetKey    String?
  rowNumber   Int?
  code        String
  severity    DataIssueSeverity
  message     String
  context     Json              @default("{}")
  createdAt   DateTime          @default(now())

  @@index([tenantId, severity, createdAt])
  @@index([importRunId, code])
}

model ReportCalculationRun {
  id                 String        @id @default(cuid())
  tenantId           String
  tenant             Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  importRunId        String
  importRun          DataImportRun @relation(fields: [importRunId, tenantId], references: [id, tenantId], onDelete: Cascade)
  dateFrom           DateTime      @db.Date
  dateTo             DateTime      @db.Date
  asOfDate           DateTime      @db.Date
  calculationVersion Int           @default(1)
  status             DataRunStatus @default(PENDING)
  warnings           Json          @default("[]")
  errorMessage       String?
  startedAt          DateTime      @default(now())
  completedAt        DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  articleResults  ArticleReportResult[]
  brandResults    BrandReportResult[]
  categoryResults CategoryReportResult[]

  @@unique([id, tenantId])
  @@unique([tenantId, importRunId, dateFrom, dateTo, asOfDate, calculationVersion], map: "ReportCalcRun_cache_key")
  @@index([tenantId, status, createdAt])
  @@index([importRunId, createdAt])
}

model ArticleReportResult {
  id                   String               @id @default(cuid())
  tenantId             String
  tenant               Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  calculationRunId     String
  calculationRun       ReportCalculationRun @relation(fields: [calculationRunId, tenantId], references: [id, tenantId], onDelete: Cascade)
  productId            String
  article              String?
  name                 String
  brand                String?
  category             String?
  costPrice            Decimal              @db.Decimal(18, 4)
  rrp                  Decimal?             @db.Decimal(18, 4)
  retailPrice          Decimal              @db.Decimal(18, 4)
  discount             Decimal?             @db.Decimal(20, 10)
  gmPct                Decimal?             @db.Decimal(20, 10)
  salesUnits           Decimal              @db.Decimal(18, 4)
  salesUah             Decimal              @db.Decimal(18, 4)
  costOfSalesUah       Decimal              @db.Decimal(18, 4)
  gpUah                Decimal              @db.Decimal(18, 4)
  salesGmPct           Decimal?             @db.Decimal(20, 10)
  stockUnits           Decimal              @db.Decimal(18, 4)
  stockUah             Decimal              @db.Decimal(18, 4)
  strPct               Decimal?             @db.Decimal(20, 10)
  avgSalesLastTwoWeeks Decimal              @db.Decimal(18, 4)
  woh                  Decimal?             @db.Decimal(20, 10)
  sourceValues         Json                 @default("{}")
  createdAt            DateTime             @default(now())

  @@unique([calculationRunId, productId])
  @@index([tenantId, calculationRunId])
  @@index([calculationRunId, brand])
  @@index([calculationRunId, category])
}

model BrandReportResult {
  id                   String               @id @default(cuid())
  tenantId             String
  tenant               Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  calculationRunId     String
  calculationRun       ReportCalculationRun @relation(fields: [calculationRunId, tenantId], references: [id, tenantId], onDelete: Cascade)
  groupKey             String
  brand                String?
  salesUah             Decimal              @db.Decimal(18, 4)
  salesUnits           Decimal              @db.Decimal(18, 4)
  costOfSalesUah       Decimal              @db.Decimal(18, 4)
  gpUah                Decimal              @db.Decimal(18, 4)
  stockUnits           Decimal              @db.Decimal(18, 4)
  stockUah             Decimal              @db.Decimal(18, 4)
  strPct               Decimal?             @db.Decimal(20, 10)
  salesSharePct        Decimal?             @db.Decimal(20, 10)
  avgSalesLastTwoWeeks Decimal              @db.Decimal(18, 4)
  woh                  Decimal?             @db.Decimal(20, 10)
  createdAt            DateTime             @default(now())

  @@unique([calculationRunId, groupKey])
  @@index([tenantId, calculationRunId])
}

model CategoryReportResult {
  id                   String               @id @default(cuid())
  tenantId             String
  tenant               Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  calculationRunId     String
  calculationRun       ReportCalculationRun @relation(fields: [calculationRunId, tenantId], references: [id, tenantId], onDelete: Cascade)
  groupKey             String
  category             String?
  salesUah             Decimal              @db.Decimal(18, 4)
  salesUnits           Decimal              @db.Decimal(18, 4)
  costOfSalesUah       Decimal              @db.Decimal(18, 4)
  gpUah                Decimal              @db.Decimal(18, 4)
  stockUnits           Decimal              @db.Decimal(18, 4)
  stockUah             Decimal              @db.Decimal(18, 4)
  strPct               Decimal?             @db.Decimal(20, 10)
  salesSharePct        Decimal?             @db.Decimal(20, 10)
  avgSalesLastTwoWeeks Decimal              @db.Decimal(18, 4)
  woh                  Decimal?             @db.Decimal(20, 10)
  createdAt            DateTime             @default(now())

  @@unique([calculationRunId, groupKey])
  @@index([tenantId, calculationRunId])
}

model DataTablePreference {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId, tenantId], references: [id, tenantId], onDelete: Cascade)
  sheetKey       String
  visibleColumns Json     @default("[]")
  pageSize       Int      @default(50)
  sortColumn     String?
  sortDirection  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, sheetKey])
  @@index([tenantId, sheetKey])
}

// ══════════════════════════════════════════════════════════════════════════════
// ASSORTMENT PLANNER
// ══════════════════════════════════════════════════════════════════════════════

// ─── CATALOG UPLOAD (one per brand per season) ────────────────────────────────
model CatalogUpload {
  id         String        @id @default(cuid())
  tenantId   String
  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  brandId    String
  brand      Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  season     String        // e.g. "SS25", "AW25"
  fileName   String?
  itemCount  Int           @default(0)
  uploadedAt DateTime      @default(now())

  items CatalogItem[]

  @@index([tenantId])
  @@index([brandId])
  @@unique([tenantId, brandId, season])
}

// ─── CATALOG ITEM (individual line in a brand's wholesale catalog) ─────────────
model CatalogItem {
  id            String        @id @default(cuid())
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  catalogId     String
  catalog       CatalogUpload @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  brandId       String
  brand         Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  sku           String
  name          String
  category      String
  color         String?
  style         String?
  material      String?
  priceWholesale Float
  priceRetail   Float?
  minOrder      Int           @default(1)
  stockAvail    Int           @default(0)
  leadTimeDays  Int           @default(28)
  tags          String[]      @default([])

  @@index([tenantId, catalogId])
  @@index([tenantId, category])
  @@unique([tenantId, catalogId, sku])
}

// ─── MARKETING CALENDAR EVENTS ────────────────────────────────────────────────
model MarketingEvent {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  weekKey   String   // "w14", "w15", ...
  rowKey    String   // "accent", "promo", "ban1", ...
  type      String   // promo | holiday | agent | warn | sale | event | stock
  label     String
  source    String   @default("user") // user | agent | system
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([tenantId, weekKey])
}

// ─── AGENT RUNS ──────────────────────────────────────────────────────────────
model AgentRun {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agentType  String    // "inventory_analyst" | "repricing" | "reordering" | ...
  entityId   String    @default("all") // brandId or "all"
  status     String    @default("idle") // "running" | "done" | "error"
  input      Json      @default("{}")
  output     Json?
  errorMsg   String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([tenantId, agentType])
  @@index([tenantId])
}

// ─── PLANNER CART (draft purchase order — one per tenant) ─────────────────────
model PlannerCart {
  id        String   @id @default(cuid())
  tenantId  String   @unique
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items     Json     @default("[]") // CartItem[]
  updatedAt DateTime @updatedAt
}
