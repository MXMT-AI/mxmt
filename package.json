{
  "name": "mxmt-analytics",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "reconcile:zavod": "node scripts/reconcile-zavod.mjs",
    "audit:zavod": "node scripts/audit-zavod-workbook.mjs",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "test:mvp": "vitest run --maxWorkers=2 tests/lib/mvp-acceptance.test.ts tests/lib/monobrand tests/lib/merchandising- tests/lib/sales- tests/lib/sku- tests/lib/repricing tests/lib/reordering tests/lib/scenario- tests/lib/connector tests/lib/salesdrive tests/lib/data-scheduler.test.ts tests/lib/zavod tests/lib/settings-data tests/lib/product- tests/lib/auth-security.test.ts",
    "predev": "npm run db:check",
    "prestart": "NODE_ENV=production npm run db:check",
    "db:check": "node scripts/database-lifecycle.mjs check",
    "build:vercel": "node scripts/database-lifecycle.mjs vercel",
    "verify:reporting:offline": "node scripts/verify-reporting-offline.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@js-temporal/polyfill": "0.5.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@tailwindcss/forms": "^0.5.9",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "fast-xml-parser": "5.11.2",
    "jose": "^6.2.14",
    "lossless-json": "4.3.3",
    "lucide-react": "^1.64.0",
    "next": "^16.4.3",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "openai": "^7.45.1",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "0.0.1",
    "tailwind-merge": "^3.7.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.13",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.32",
    "prisma": "7.10.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "npm@11.19.1"
}
